# Supabase Environment Variables
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For local development with Supabase redirects
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Cloudflare R2 — scenario video storage
# Everything else stays in Supabase; only scenario videos live here.
# Account ID: Cloudflare dashboard → R2 → Overview (right-hand sidebar)
R2_ACCOUNT_ID=your-cloudflare-account-id
# API token: R2 → Manage API tokens → Create (Object Read & Write on this bucket)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=refzone-scenario-videos
# Public base URL of the bucket's connected custom domain, no trailing slash.
# NOT the r2.dev URL — that is rate limited and unsuitable for production.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://videos.example.com
